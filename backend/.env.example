# Database Connection (MongoDB Atlas in Production or Local in Development)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/career_horizon?retryWrites=true&w=majority

# Port (Automatically injected by Render in production, defaults to 5000 locally)
PORT=5000

# Authentication Secret
JWT_SECRET=your_strong_jwt_secret_here

# Frontend Application URL for CORS
# In production, set to your Vercel URL (e.g. https://career-horizon.vercel.app)
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# AI Career Guidance Assistant Configuration (Google Gemini Free Tier)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3-flash-preview

# Optional Email Notification Settings (Nodemailer - Gmail or SMTP)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_char_app_password
EMAIL_FROM="Career Horizon" <no-reply@careerhorizon.com>
